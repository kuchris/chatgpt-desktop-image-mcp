{
  "name": "codeximg",
  "version": "0.2.0",
  "private": true,
  "description": "ChatGPT image generation as an MCP tool, via the Codex desktop app over CDP — no API key, no Codex quota.",
  "type": "module",
  "bin": {
    "codeximg": "generate.mjs",
    "codeximg-mcp": "mcp-server.mjs"
  },
  "scripts": {
    "gen": "node generate.mjs",
    "status": "node generate.mjs --status",
    "focus": "node generate.mjs --focus",
    "mcp": "node mcp-server.mjs",
    "smoke": "node smoke-test.mjs",
    "launch": "powershell -File launch-app.ps1"
  },
  "engines": {
    "node": ">=22"
  }
}
